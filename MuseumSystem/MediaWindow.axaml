<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MuseumSystem.MediaWindow"
		Background="#E8BC75"
        Title="Медиа">
	<ScrollViewer>
		<Grid Margin="10" RowDefinitions="5*,*,*,5*,*">
			<Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*">
				<Image IsVisible="False" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2" Name="ShownImage"/>
				<Button IsVisible="False" Content="Проиграть" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2" Name="PlayButton" Click="PlayButton_Click"/>
				<StackPanel Name="VideoPannel" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2" x:Name="VideoContainer">
					<Rectangle Fill="Black" Width="400" Height="300"/>
				</StackPanel>
			</Grid>
			<Grid Grid.Row="1" Margin="5,0">
				<Button  Content="Добавить медиа файл" Click="AddButton_Click"/>
				<Button Content="Проиграть" Name="PlayVideo" HorizontalAlignment="Center" Click="VideoButton_Click" IsVisible="False"/>
			</Grid>
			<TextBox Name="Name" Grid.Row="2" Margin="5" Watermark="Наименование" />
			<TextBox Name="Description" Grid.Row="3" Margin="5" Watermark="Описание"/>
			<Button Margin="5,0" Grid.Row="4" HorizontalAlignment="Stretch" Content="Готово" Click="ReadyButton_Click"/>
		</Grid>
	</ScrollViewer>

</Window>
